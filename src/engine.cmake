# 3rdparty.cmake — engine generated by `cpm`. Static part (registrations appended below).
#
# Two-phase fallback resolver:
#   cpm_declare_package(KEY .. PACKAGE .. OPTIONS .. ALIASES .. PRE .. POST ..)
#   cpm_declare_fallback(KEY .. TIER git|tar|loc WHEN .. GIT .. TAG .. URL .. HASH .. OPTIONS ..)
#   cpm_resolve_fallback(<key>)  -> sets <PACKAGE>_FOUND, called from Find<Package>.cmake
include_guard(GLOBAL)

# Pull in CPM if the project hasn't already. OPTIONAL => projects that vendor
# CPM themselves (include(CPM) before this file) are not disturbed.
include("${CMAKE_CURRENT_LIST_DIR}/get_cpm.cmake" OPTIONAL)

# ---- configurable knobs (override BEFORE including this file) --------------
if(NOT DEFINED CPM_PRELOAD AND DEFINED ENV{CPM_PRELOAD})
  file(TO_CMAKE_PATH "$ENV{CPM_PRELOAD}" CPM_PRELOAD)
endif()

# Patch application: a command prefix that takes ONE patch file as its last arg.
# Default works on Linux/macOS. On Windows override in configure.cmake, e.g.
#   set(CPM_PATCH_COMMAND "${Python3_EXECUTABLE} -m patch -p1" CACHE STRING "" FORCE)
set(CPM_PATCH_COMMAND "patch -p1 -i" CACHE STRING
    "cpm: command prefix that applies ONE .patch file (the file is appended as the last arg)")
set(CPM_PATCH_PREFIX "${PROJECT_SOURCE_DIR}/build/patches" CACHE PATH
    "cpm: root directory of patch files (looked up as <CPM_PATCH_PREFIX>/<archive-base>/<name>.patch)")

# ---- package-level declaration ---------------------------------------------
function(cpm_declare_package)
  cmake_parse_arguments(ARG "" "KEY;PACKAGE;VERSION;PRE;POST" "OPTIONS;ALIASES" ${ARGN})
  set_property(GLOBAL PROPERTY "CPM_PKG_NAME_${ARG_KEY}"    "${ARG_PACKAGE}")
  set_property(GLOBAL PROPERTY "CPM_PKG_VER_${ARG_KEY}"     "${ARG_VERSION}")
  set_property(GLOBAL PROPERTY "CPM_PKG_OPTS_${ARG_KEY}"    "${ARG_OPTIONS}")
  set_property(GLOBAL PROPERTY "CPM_PKG_ALIASES_${ARG_KEY}" "${ARG_ALIASES}")
  set_property(GLOBAL PROPERTY "CPM_PKG_PRE_${ARG_KEY}"     "${ARG_PRE}")
  set_property(GLOBAL PROPERTY "CPM_PKG_POST_${ARG_KEY}"    "${ARG_POST}")
  set_property(GLOBAL APPEND PROPERTY CPM_PKG_KEYS "${ARG_KEY}")
endfunction()

# ---- candidate (tier) declaration ------------------------------------------
function(cpm_declare_fallback)
  cmake_parse_arguments(ARG "" "KEY;TIER;WHEN;GIT;TAG;URL;HASH" "OPTIONS" ${ARGN})
  get_property(_n GLOBAL PROPERTY "CPM_FB_${ARG_KEY}_N")
  if(NOT _n)
    set(_n 0)
  endif()
  set_property(GLOBAL PROPERTY "CPM_FB_${ARG_KEY}_${_n}_TIER" "${ARG_TIER}")
  set_property(GLOBAL PROPERTY "CPM_FB_${ARG_KEY}_${_n}_WHEN" "${ARG_WHEN}")
  set_property(GLOBAL PROPERTY "CPM_FB_${ARG_KEY}_${_n}_GIT"  "${ARG_GIT}")
  set_property(GLOBAL PROPERTY "CPM_FB_${ARG_KEY}_${_n}_TAG"  "${ARG_TAG}")
  set_property(GLOBAL PROPERTY "CPM_FB_${ARG_KEY}_${_n}_URL"  "${ARG_URL}")
  set_property(GLOBAL PROPERTY "CPM_FB_${ARG_KEY}_${_n}_HASH" "${ARG_HASH}")
  set_property(GLOBAL PROPERTY "CPM_FB_${ARG_KEY}_${_n}_OPTS" "${ARG_OPTIONS}")
  math(EXPR _n "${_n} + 1")
  set_property(GLOBAL PROPERTY "CPM_FB_${ARG_KEY}_N" "${_n}")
endfunction()

# ---- resolve: called from Find<Package>.cmake ------------------------------
function(cpm_resolve_fallback key)
  get_property(_pkg     GLOBAL PROPERTY "CPM_PKG_NAME_${key}")
  get_property(_ver     GLOBAL PROPERTY "CPM_PKG_VER_${key}")
  get_property(_popts   GLOBAL PROPERTY "CPM_PKG_OPTS_${key}")
  get_property(_aliases GLOBAL PROPERTY "CPM_PKG_ALIASES_${key}")
  get_property(_pre     GLOBAL PROPERTY "CPM_PKG_PRE_${key}")
  get_property(_post    GLOBAL PROPERTY "CPM_PKG_POST_${key}")
  get_property(_n       GLOBAL PROPERTY "CPM_FB_${key}_N")

  if(NOT (_pre STREQUAL ""))
    include("${CMAKE_CURRENT_LIST_DIR}/${_pre}" OPTIONAL)
  endif()

  set(_ok FALSE)

  if(NOT "${_n}" STREQUAL "")
    math(EXPR _last "${_n} - 1")
    foreach(_i RANGE "${_last}")
      get_property(_tier GLOBAL PROPERTY "CPM_FB_${key}_${_i}_TIER")
      get_property(_when GLOBAL PROPERTY "CPM_FB_${key}_${_i}_WHEN")
      get_property(_git  GLOBAL PROPERTY "CPM_FB_${key}_${_i}_GIT")
      get_property(_tag  GLOBAL PROPERTY "CPM_FB_${key}_${_i}_TAG")
      get_property(_url  GLOBAL PROPERTY "CPM_FB_${key}_${_i}_URL")
      get_property(_hash GLOBAL PROPERTY "CPM_FB_${key}_${_i}_HASH")
      get_property(_topts GLOBAL PROPERTY "CPM_FB_${key}_${_i}_OPTS")

      if(NOT (_when STREQUAL ""))
        if(NOT (${_when}))
          continue()
        endif()
      endif()

      set(_args NAME ${_pkg})
      if(NOT (_ver STREQUAL ""))
        list(APPEND _args VERSION "${_ver}")
      endif()
      list(APPEND _args ${_popts})
      list(APPEND _args ${_topts})

      set(_try FALSE)
      if(_tier STREQUAL "git")
        execute_process(COMMAND git ls-remote "${_git}"
                        RESULT_VARIABLE _rv TIMEOUT 20 OUTPUT_QUIET ERROR_QUIET)
        if(_rv EQUAL 0)
          message(STATUS "cpm/fallback[${_pkg}] git: ${_git} @ ${_tag}")
          list(APPEND _args GIT_REPOSITORY "${_git}" GIT_TAG "${_tag}")
          set(_try TRUE)
        endif()
      elseif(_tier STREQUAL "tar")
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/_cpm_fb")
        file(DOWNLOAD "${_url}" "${CMAKE_BINARY_DIR}/_cpm_fb/${key}.probe"
             STATUS _st TIMEOUT 30 INACTIVITY_TIMEOUT 15)
        list(GET _st 0 _code)
        if(_code EQUAL 0)
          message(STATUS "cpm/fallback[${_pkg}] tarball: ${_url}")
          list(APPEND _args URL "${_url}")
          set(_try TRUE)
        endif()
      elseif(_tier STREQUAL "loc")
        if(EXISTS "${_url}")
          message(STATUS "cpm/fallback[${_pkg}] local: ${_url}")
          list(APPEND _args URL "file://${_url}")
          if(NOT (_hash STREQUAL ""))
            list(APPEND _args URL_HASH "${_hash}")
          endif()
          set(_try TRUE)
        endif()
      endif()

      if(_try)
        CPMAddPackage(${_args})
        set(_ok TRUE)
        break()
      endif()
    endforeach()
  else()
    # no source candidates: a synthetic, target-only package (PRE/POST do the work)
    set(_ok TRUE)
  endif()

  if(_ok)
    foreach(_pair IN LISTS _aliases)
      string(REPLACE "=" ";" _kv "${_pair}")
      list(LENGTH _kv _kvlen)
      if(_kvlen EQUAL 2)
        list(GET _kv 0 _alias)
        list(GET _kv 1 _under)
        # resolve one level of aliasing: cannot ALIAS an ALIAS, so use the real target
        if(TARGET "${_under}")
          get_target_property(_real "${_under}" ALIASED_TARGET)
          if(_real STREQUAL "_real-NOTFOUND")
            set(_real "${_under}")
          endif()
          if(NOT TARGET "${_alias}")
            add_library("${_alias}" ALIAS "${_real}")
          endif()
        endif()
      endif()
    endforeach()
    if(NOT (_post STREQUAL ""))
      include("${CMAKE_CURRENT_LIST_DIR}/${_post}" OPTIONAL)
    endif()
    set(${_pkg}_FOUND TRUE PARENT_SCOPE)
  else()
    set(${_pkg}_FOUND FALSE PARENT_SCOPE)
  endif()
endfunction()
